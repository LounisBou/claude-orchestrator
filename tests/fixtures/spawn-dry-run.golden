successor=no
auditor=no
coordinator_successor=no
wake=no
open=no
chain=append
resident=no
name=Agent : r
title_free=no
mcp=a
mcp_file=@WORK@/state/prompts/mcp-Agent---r-@TIME@.json
account_connectors=no
synced_skills=removed
tools_removed=Artifact,SendFeedback,Workflow,ScheduleWakeup,ReportFindings,mcp__orchestrator__move_send,mcp__orchestrator__move_probe,mcp__orchestrator__end_session
remote_control=no
mode_check=skipped
program=/bin/sh -l <launch-file>
close=/dev/ttys950 expect_title=
exit=0
### rotate, coordinator refused
ERROR: rotate: refused: /dev/ttys951 is the coordinator's tab ('Coord : c'): the coordinator is not an agent and is not rotated (pass --force to rotate it anyway)
exit=1
### rotate, successor refused
ERROR: rotate: refused: --successor is not a rotation's (a rotation replaces an agent with a titled agent; a successor is spawned with spawn --successor)
exit=1
### move, own agent right of self
move=/dev/ttys901 right_of=/dev/ttys900
exit=0
### move, own agent left of a tab
move=/dev/ttys901 left_of=/dev/ttys555
exit=0
### move, leftmost
move=/dev/ttys901 left_of=leftmost
exit=0
### move, a stranger refused
ERROR: move: refused: /dev/ttys777 is neither this session's tab nor in its chain (pass --force to move it anyway)
exit=1
### move, a stranger forced
move: forced: /dev/ttys777 is not in this session's chain
move=/dev/ttys777 left_of=/dev/ttys555
exit=0
### move, auditor refused
ERROR: move: refused: /dev/ttys950 is an auditor's tab ('Audit : tm'), not this session's to place (pass --force to move it anyway)
exit=1
### move, coordinator refused
ERROR: move: refused: /dev/ttys951 is the coordinator's tab ('Coord : c'), not this session's to place (pass --force to move it anyway)
exit=1
### move, same session refused
ERROR: move: --tty and its anchor are the same session
exit=1
### move, no place refused
ERROR: move: --left-of, --right-of or --leftmost is required
exit=1
